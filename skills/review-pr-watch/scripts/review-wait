#!/usr/bin/env python3
"""review-wait: watch one GitHub pull request you reviewed and print one line per event.

  review-wait <pr> [--repo owner/name] [--interval 60] [--quiet 900]

<pr> is a PR number or PR URL. Without --repo, the repo comes from the URL or
from the current checkout. Stdout carries only events, one line each, so
whatever runs it in the background wakes the agent once per batch. Progress and
errors that do not end the run go to stderr.

--quiet
  Author activity (commits, comments, thread replies, reviews by the PR author)
  is printed only after this many seconds without newer author activity. Other
  people's comments and a new request for your review are printed at once.

Exit codes
  0  an event batch was printed, you approved, or the PR merged
  1  the PR closed without merging, or GitHub stayed unreachable
  2  bad arguments, unknown PR, or another review-wait already watches this PR

Events
  approved: <url>                      your review is APPROVED
  merged: <url>
  closed without merging: <url>
  review requested again: <url>        you were requested as a reviewer again
  new commits on <sha7> (committed <date>): <url>          quiet window
  author comment | new thread | thread reply | review (<state>) from <login> ...
                                                           quiet window
  comment | new thread | thread reply | review (<state>) from <login> ...
                                                           by anyone else

Bots and you are skipped. Edits are never events. State lives in
~/.local/state/review-wait/ and has no age limit, so a restarted watcher reports
what arrived while it was down. A lock makes a second watcher for the same PR
exit with code 2. The first run records what already exists and reports only
what comes after.
"""

from __future__ import annotations

import argparse
import fcntl
import html
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Any, NoReturn

STATE_DIR = Path.home() / ".local" / "state" / "review-wait"
MAX_FAILED_POLLS = 10
TRANSIENT = re.compile(
    r"HTTP (5\d\d|429)|rate limit|timed? ?out|connection (reset|refused)|EOF|"
    r"temporar|could not resolve host|TLS handshake|Something went wrong",
    re.IGNORECASE,
)

QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  viewer { login }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state headRefOid
      author { login }
      commits(last: 1) { nodes { commit { committedDate } } }
      reviewRequests(first: 100) {
        nodes { id requestedReviewer { __typename ... on User { login } } }
      }
      comments(last: 100) { nodes { id url body createdAt author { login __typename } } }
      reviews(last: 100) { nodes { id url state body submittedAt author { login __typename } } }
      reviewThreads(last: 100) {
        nodes {
          path line
          comments(first: 100) { nodes { id url body createdAt author { login __typename } } }
        }
      }
    }
  }
}
"""

Json = dict[str, Any]


class GhError(Exception):
    def __init__(self, message: str, transient: bool) -> None:
        super().__init__(message)
        self.transient = transient


def log(message: str) -> None:
    print(f"review-wait: {message}", file=sys.stderr, flush=True)


def fail(message: str, code: int = 2) -> NoReturn:
    # Fatal messages go to stdout so a monitor shows the agent why it stopped.
    print(f"review-wait: {message}", flush=True)
    sys.exit(code)


def gh(args: list[str]) -> subprocess.CompletedProcess[str]:
    """Run gh. Retries transient failures (HTTP 5xx or 429, network) with backoff."""
    delay = 2
    for attempt in range(5):
        proc = subprocess.run(["gh", *args], capture_output=True, text=True)
        if proc.returncode == 0:
            return proc
        lines = proc.stderr.strip().splitlines()
        message = lines[-1] if lines else f"gh exited {proc.returncode}"
        transient = bool(TRANSIENT.search(proc.stderr))
        if not transient or attempt == 4:
            raise GhError(message, transient)
        log(f"gh {' '.join(args[:2])}: {message}; retry in {delay}s")
        time.sleep(delay)
        delay *= 2
    raise AssertionError("unreachable")


def who(node: Json) -> tuple[str, bool]:
    author = node.get("author") or {}
    return author.get("login") or "ghost", author.get("__typename") == "Bot"


def stamp(value: str | None) -> float | None:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp() if value else None


def snippet(body: str, limit: int = 100) -> str:
    text = re.sub(r"<!--.*?-->", " ", body or "", flags=re.DOTALL)
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    text = re.sub(r"\s+", " ", text).strip()
    return text if len(text) <= limit else text[: limit - 3] + "..."


def parse_target(raw: str | None, repo: str | None) -> tuple[str, int]:
    if raw is None or not raw.strip():
        fail("missing PR number. Usage: review-wait <pr> [--repo owner/name]")
    url = re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)(?:[/?#]\S*)?", raw.strip())
    number = re.fullmatch(r"#?(\d+)", raw.strip())
    if url:
        repo = repo or url.group(1)
        pr = int(url.group(2))
    elif number:
        pr = int(number.group(1))
    else:
        fail(f"'{raw}' is not a PR number or PR URL")
    if pr <= 0:
        fail(f"'{raw}' is not a valid PR number")
    if not repo:
        try:
            repo = gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).stdout.strip()
        except GhError as error:
            fail(f"no --repo given and the current directory has no GitHub repo ({error})")
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
        fail(f"'{repo}' is not owner/name")
    try:
        gh(["pr", "view", str(pr), "-R", repo, "--json", "number"])
    except GhError as error:
        if not error.transient:  # a transient failure is retried by the poll loop
            fail(f"cannot read {repo}#{pr}: {error}")
    return repo, pr


def lock(repo: str, pr: int) -> Any:
    """Hold a per-PR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{repo.replace('/', '__')}__{pr}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        fail(
            f"pid {pid} already watches {repo}#{pr}, so this watcher exits to avoid "
            f"duplicate events. If no events reach you from it, run `kill {pid}` and start again."
        )
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


class Watcher:
    def __init__(self, repo: str, pr: int, quiet: int, interval: int) -> None:
        self.repo, self.pr, self.quiet, self.interval = repo, pr, quiet, interval
        self.owner, self.name = repo.split("/")
        self.path = STATE_DIR / f"{repo.replace('/', '__')}__{pr}.json"
        state = self.load()
        # First run for this PR: record what exists and report nothing.
        self.baseline = state is None
        # seen: last head SHA observed. activity: when that head was first observed.
        self.state: Json = state or {"reported": [], "seen": None, "activity": 0.0}
        self.reported: set[str] = set(self.state["reported"])

    def load(self) -> Json | None:
        try:
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def finish(self, code: int, lines: list[str]) -> NoReturn:
        self.save()
        for line in lines:
            print(f"#{self.pr} {line}", flush=True)
        sys.exit(code)

    def fetch_pr(self) -> Json:
        proc = gh([
            "api", "graphql", "-f", f"query={QUERY}",
            "-f", f"owner={self.owner}", "-f", f"name={self.name}", "-F", f"number={self.pr}",
        ])
        data = json.loads(proc.stdout)["data"]
        pr = data["repository"]["pullRequest"]
        pr["viewer"] = data["viewer"]["login"]
        pr["author"] = (pr["author"] or {}).get("login")
        return pr

    def add(self, batch: list[tuple[float | None, str, str]], key: str, line: str, ts: float | None = None) -> None:
        """Queue an event once. ts None prints it at once; a ts waits for the quiet window after it."""
        if key in self.reported:
            return
        if self.baseline:
            self.reported.add(key)
        else:
            batch.append((ts, key, line))

    def route(self, batch: list[tuple[float | None, str, str]], node: Json, kind: str, where: str, pr: Json) -> None:
        login, is_bot = who(node)
        if login == pr["viewer"] or is_bot:
            return
        author_side = login == pr["author"]
        prefix = "author " if author_side else ""
        place = f" on {where}" if where else ""
        text = " ".join(filter(None, [snippet(node.get("body") or ""), node["url"]]))
        ts = (stamp(node.get("createdAt") or node.get("submittedAt")) or time.time()) if author_side else None
        self.add(batch, f"c:{node['id']}", f"{prefix}{kind} from {login}{place}: {text}", ts)

    def poll(self) -> None:
        pr = self.fetch_pr()
        url, viewer, head = pr["url"], pr["viewer"], pr["headRefOid"]
        if pr["state"] == "MERGED":
            self.finish(0, [f"merged: {url}"])
        if pr["state"] == "CLOSED":
            self.finish(1, [f"closed without merging: {url}"])
        if any(who(review)[0] == viewer and review["state"] == "APPROVED" for review in pr["reviews"]["nodes"]):
            self.finish(0, [f"approved: {url}"])

        now = time.time()
        if head != self.state["seen"]:
            self.state["seen"] = head
            self.state["activity"] = now
        batch: list[tuple[float | None, str, str]] = []
        commits = pr["commits"]["nodes"]
        committed = commits[0]["commit"]["committedDate"] if commits else "unknown"
        self.add(batch, f"head:{head}", f"new commits on {head[:7]} (committed {committed}): {url}", self.state["activity"])
        for request in pr["reviewRequests"]["nodes"]:
            if (request["requestedReviewer"] or {}).get("login") == viewer:
                self.add(batch, f"rr:{request['id']}", f"review requested again: {url}")
        for comment in pr["comments"]["nodes"]:
            self.route(batch, comment, "comment", "", pr)
        for review in pr["reviews"]["nodes"]:
            if review["state"] in ("APPROVED", "CHANGES_REQUESTED") or (review["body"] or "").strip():
                self.route(batch, review, f"review ({review['state'].lower().replace('_', ' ')})", "", pr)
        for thread in pr["reviewThreads"]["nodes"]:
            where = f"{thread['path']}:{thread['line']}" if thread["line"] else thread["path"]
            for index, comment in enumerate(thread["comments"]["nodes"]):
                self.route(batch, comment, "new thread" if index == 0 else "thread reply", where, pr)

        # Quiet window: queued author-side items wait until no author activity is newer than `quiet` seconds.
        last = max([self.state["activity"], *(ts for ts, _, _ in batch if ts is not None)])
        due = [(key, line) for ts, key, line in batch if ts is None or now - last >= self.quiet]
        if due:
            self.reported.update(key for key, _ in due)
            self.finish(0, [line for _, line in due])

    def run(self) -> NoReturn:
        failures = 0
        while True:
            try:
                self.poll()
                failures = 0
            except GhError as error:
                if not error.transient:
                    self.finish(1, [f"review-wait stopped: {error}"])
                failures += 1
                log(f"poll failed ({failures}/{MAX_FAILED_POLLS}): {error}")
                if failures >= MAX_FAILED_POLLS:
                    self.finish(1, [f"review-wait stopped: GitHub unreachable for {failures} polls: {error}"])
            else:
                self.save()
                if self.baseline:
                    log(f"baseline recorded for {self.repo}#{self.pr}; reporting only new events")
                self.baseline = False
            time.sleep(self.interval)


def main() -> None:
    parser = argparse.ArgumentParser(prog="review-wait", description="Watch a GitHub PR you reviewed and print one line per event.")
    parser.add_argument("pr", nargs="?", help="PR number or URL")
    parser.add_argument("--repo", help="owner/name (default: from the URL or the current checkout)")
    parser.add_argument("--interval", type=int, default=60, help="seconds between polls (default 60, min 5)")
    parser.add_argument(
        "--quiet", type=int, default=900,
        help="seconds without newer author activity before author commits and replies are printed (default 900)",
    )
    args = parser.parse_args()
    if args.quiet < 0:
        parser.error("--quiet must be 0 or more")
    repo, pr = parse_target(args.pr, args.repo)
    _lock = lock(repo, pr)
    Watcher(repo, pr, args.quiet, max(args.interval, 5)).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
